  <!-- 실물 90도 마운트 (mount.STL, mm -> scale 0.001) -- 시각화 전용.
       별도 link/collision 없이 tcp visual 로만 넣어 body 수(29)/DOF(22)/물리 불변.
       배치: 플랜지면(y77 원판, PCD50 4xM6)을 tcp 면에 밀착, 축(x40,z40)을 플랜지 축에 정렬.
       실측 손바닥 중심 (0,-57,95) vs 본 URDF vmount (0,-60,95): y 3mm 차이(손 밑면 3mm 뜸). -->
  <link name="tcp">
    <visual>
      <origin xyz="0.040 -0.077 -0.040" rpy="0 -1.5707963 0"/>
      <geometry>
        <mesh filename="mount/mount.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
  <joint name="base" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.1692"/>
    <parent link="link0"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.1416"/>
  </joint>
  <joint name="shoulder" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.1416"/>
  </joint>
  <joint name="elbow" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.425"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.8798" upper="2.8798" effort="150" velocity="3.1416"/>
  </joint>
  <joint name="wrist1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.392"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.1416"/>
  </joint>
  <joint name="wrist2" type="revolute">
    <origin rpy="0 0 0" xyz="0 -0.1107 0.1107"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.1416"/>
  </joint>
  <joint name="wrist3" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.1416"/>
  </joint>
  <joint name="tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0967 0"/>
    <parent link="link6"/>
    <child link="tcp"/>
  </joint>

  <!-- allegro 를 RB5 플랜지(tcp)에 고정. base_link 원점은 손바닥 중심이고
       mesh 가 원점 아래 -z 95mm(마운트 면)까지 뻗으므로, "마운트 면이 플랜지에서
       30mm" 가 되려면 원점은 95+30=125mm 바깥에 있어야 한다.
       Rx(+90도): 손 +z(손가락 방향) -> tcp -y (플랜지 바깥) -->
  <joint name="hand_mount" type="fixed">
    <parent link="tcp"/>
    <child link="base_link"/>
    <origin xyz="0 -0.060 0.095" rpy="0 0 -1.5707963"/>
  </joint>

  <link name="base_link">
